# Modified for Identale; see the root NOTICE.
# Local start.sh / local:start create .env if missing and read it on every start.
# Precedence: process environment > .env > code defaults. Existing .env is never replaced.
# Only DENTITY_* values are loaded; shell expressions and variable expansion are not executed.
# Path settings support ~/ (the current user's home) and paths relative to the checkout.
# Direct service entries and systemd use their own process environment.
# Account/configuration management works without a model key; inference remains unavailable.
# bash scripts/start.sh and npm run local:start reuse private credentials outside the repo.
# A fresh local installation creates missing credentials; existing data without its key is refused.
# npm run local:init optionally initializes credentials without starting services.
# Local startup derives scoped service tokens and never replaces stored keys.
# Private file outside the repository. Defaults use ~/.identale; explicit paths take precedence.
DENTITY_LOCAL_SECRETS_PATH=~/.identale/local-secrets.json
DENTITY_WEB_PORT=15173
DENTITY_APP_ORIGIN=http://127.0.0.1:15173
DENTITY_CONTROL_PLANE_PORT=18300
DENTITY_RUNTIME_SERVICE_PORT=18304
DENTITY_RUNTIME_HOST_PI_PORT=18301
DENTITY_DATABASE_PATH=~/.identale/platform/platform.sqlite
DENTITY_RUNTIME_DATABASE_PATH=~/.identale/runtime/runtime.sqlite
DENTITY_SKILL_RESOURCE_ROOT=~/.identale/resources/skills
# External HTTPS origins require true in both platform and runtime service environments.
# Leave false for the default local HTTP launcher.
DENTITY_SECURE_COOKIES=false

# Empty: reuse the launcher's private canonical-base64 32-byte master key.
# Set only when managing the original master key externally, with both PI tokens.
# Never commit keys. Enter provider API keys through the authenticated write-only UI.
DENTITY_MODEL_MASTER_KEY=
# HTTPS model addresses need no Origin allowlist. HTTP is loopback-only and opt-in.
DENTITY_MODEL_ALLOW_LOOPBACK_HTTP=false
DENTITY_TRIGGER_ALLOW_LOOPBACK_HTTP=false

# The launcher derives internal URLs from ports when empty. If supplied they must match.
# The platform and runtime receive two distinct scoped transport tokens.
DENTITY_RUNTIME_SERVICE_URL=
DENTITY_RUNTIME_SERVICE_TOKEN=
DENTITY_PLATFORM_CONFIG_URL=
DENTITY_PLATFORM_CONFIG_TOKEN=
DENTITY_PLATFORM_CONFIG_POLL_INTERVAL_MS=1000
# PI metadata monitor token goes only to platform and PI; it cannot execute tasks.
DENTITY_PI_MONITOR_TOKEN=

# Manual local-pi startup: configure runtime service and PI Host together, distinct tokens.
DENTITY_RUNTIME_HOST_URL=
DENTITY_RUNTIME_HOST_TOKEN=
DENTITY_PLATFORM_RESOLVER_TOKEN=
# Host resource/model resolver is the runtime service, never the platform.
# Normally http://127.0.0.1:18304/internal/runtime
DENTITY_PLATFORM_RESOLVER_URL=
DENTITY_RUNTIME_HOST_STATE_DIR=~/.identale/runtime-host-pi
DENTITY_RUNTIME_HOST_RESOURCE_REGISTRY=
# Each resource must explicitly have shared:true XOR workspaceIds:[...]. Empty is safest.
DENTITY_APPROVED_RESOURCES_JSON=[]
