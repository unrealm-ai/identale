# Runtime owns conversations/tasks and builtin records; never receives the model master key.
DENTITY_APP_ORIGIN={{ORIGIN}}
DENTITY_SECURE_COOKIES=true
DENTITY_RUNTIME_SERVICE_PORT=18304
DENTITY_RUNTIME_DATABASE_PATH={{DATABASE}}
DENTITY_BUILTIN_RECORD_ROOT={{RECORDS}}
DENTITY_PLATFORM_CONFIG_URL=http://127.0.0.1:18300
DENTITY_RUNTIME_HOST_URL=http://127.0.0.1:18301
DENTITY_MODEL_ALLOW_LOOPBACK_HTTP=true
DENTITY_TRIGGER_ALLOW_LOOPBACK_HTTP=true
