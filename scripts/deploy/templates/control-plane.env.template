# Platform owns identity/configuration storage and receives only the model master key.
DENTITY_APP_ORIGIN={{ORIGIN}}
DENTITY_SECURE_COOKIES=true
DENTITY_CONTROL_PLANE_PORT=18300
DENTITY_DATABASE_PATH={{DATABASE}}
DENTITY_RUNTIME_SERVICE_URL=http://127.0.0.1:18304
DENTITY_RUNTIME_HOST_URL=http://127.0.0.1:18301
DENTITY_MODEL_ALLOW_LOOPBACK_HTTP=true
