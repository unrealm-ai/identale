# Modified for Identale; see the root NOTICE.
# Node dependencies and build outputs (keep package-lock.json and source config)
node_modules/
dist/
build/
!/scripts/build/
*.tsbuildinfo
.npm/
.pnpm-store/
.yarn/cache/

# Local application state: databases, sessions, tools and execution artifacts
/.identale/
/.identale-mode/
/.identale-mode-transition/
/.local-env-*/
/.identity/
/var/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-wal
*.db-shm
*.db-journal
*.jsonl
*.jsonl.*

# Real environment files and credentials; only non-secret examples belong in Git
.env
.env.*
!.env.example
!**/.env.example
.envrc
.npmrc
local-secrets.json
local-secrets.*.json
*.pem
*.key
*.p12
*.pfx
*.keystore

# Temporary test / browser output and debugging captures
.ui-test-*/
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.vite/
.cache/
.tmp/
tmp/
*.log
*.pid
*.pid.lock
*.har
*.trace
*.heapsnapshot
*.cpuprofile

# Private reports, daily iteration logs and raw evidence are local-only.
/docs/verification/
/docs/private/
/docs/design/
/docs/changes/

# Workstation metadata, editor-local settings, caches and scratch files
.DS_Store
.AppleDouble
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
__pycache__/
*.py[cod]
.venv/

# This file does not untrack files or scrub history. Never use git add -f
# to publish local state, credentials or unreviewed screenshots/logs.
